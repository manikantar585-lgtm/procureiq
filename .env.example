# ---------- SAP S/4HANA connectivity ----------
# mock    : bundled S/4HANA-shaped data (default, no SAP account needed)
# sandbox : SAP Business Accelerator Hub sandbox (free key at https://api.sap.com -> Show API Key)
# tenant  : a real S/4HANA system
SAP_MODE=mock
SAP_API_KEY=
SAP_BASE_URL=
SAP_USER=
SAP_PASSWORD=

# ---------- GenAI (pick one; leave all empty for offline mode) ----------
# LLM_PROVIDER = gemini | openai | groq | ollama | anthropic | sap-ai-core
LLM_PROVIDER=
LLM_MODEL=
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_URL=http://localhost:11434

# ---------- ML service ----------
ML_SERVICE_URL=http://localhost:8000

# ---------- Business rules ----------
APPROVAL_LIMIT=1000000
TOL_PRICE_PCT=2
TOL_PRICE_PCT_FAIL=5
SEED_DEMO=true
